{
  "ref": "personal_site_security_headers",
  "description": "Initial security headers for HTTPS personal site",
  "expression": "(http.host eq \"ingramgeoai.com\" and ssl)",
  "action": "rewrite",
  "action_parameters": {
    "headers": {
      "content-security-policy": {
        "operation": "set",
        "value": "base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
      },
      "x-frame-options": {
        "operation": "set",
        "value": "DENY"
      },
      "x-content-type-options": {
        "operation": "set",
        "value": "nosniff"
      },
      "referrer-policy": {
        "operation": "set",
        "value": "strict-origin-when-cross-origin"
      },
      "strict-transport-security": {
        "operation": "set",
        "value": "max-age=86400"
      }
    }
  },
  "enabled": true
}
